---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout lang="en" title="Page not found" noAlternates>
  <section class="nf">
    <div class="container">
      <p class="code mono muted">404</p>
      <h1>Page not found <span lang="th" class="th">· ไม่พบหน้านี้</span></h1>
      <p class="secondary">The link may have changed. ลิงก์อาจเปลี่ยนไปแล้ว</p>
      <div class="actions">
        <a class="btn btn-primary" href="/th/">หน้าแรก <Icon name="arrow-right" /></a>
        <a class="btn btn-quiet" href="/en/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--s-24) var(--s-32);
  }
  .code {
    font-size: var(--fs-13);
    margin-bottom: var(--s-4);
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.5rem);
    letter-spacing: -0.02em;
  }
  .th {
    color: var(--text-3);
  }
  .secondary {
    margin-top: var(--s-3);
    font-size: var(--fs-18);
  }
  .actions {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
</style>
