---
import BaseLayout from './BaseLayout.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { useT, localizePath, type Lang } from '../i18n/ui';
import { getLegal } from '../lib/content';

interface Props {
  lang: Lang;
  doc: 'terms' | 'privacy';
}
const { lang, doc } = Astro.props;
const t = useT(lang);
const entry = await getLegal(lang, doc);
const other = doc === 'terms' ? 'privacy' : 'terms';
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.summary}>
  <LegalDoc lang={lang} entry={entry} other={{ href: localizePath(lang, `/${other}/`), label: t(`footer.${other}`) }} />
</BaseLayout>
