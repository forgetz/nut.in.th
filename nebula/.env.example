# Copy to .env and fill in. .env is git-ignored.
# Use the hosting server's FTP host name (from your hosting panel), not a Cloudflare-proxied domain.
FTP_HOST=ftp.example.com
# 21 for FTP / explicit FTPS, 990 for implicit FTPS, or whatever your host gives you
FTP_PORT=21
FTP_USER=
FTP_PASS=
# Remote folder that is the web root of nut.in.th (often public_html or httpdocs)
FTP_DIR=/public_html
# true = explicit FTPS (AUTH TLS), implicit = implicit FTPS, false = plain FTP
FTP_SECURE=true
